# Model provider: azure, openai or local. Set, it wins and refuses to start without its values.
# Empty: Azure if its three values are set, else OpenAI-compatible if OPENAI_API_KEY is set, else local (sample mode).
MODEL_PROVIDER=

# Azure OpenAI (documented target). Leave empty to run in sample mode.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21   # or v1

# Optional alternative: any OpenAI-compatible endpoint. Used only if Azure is not configured.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# json_schema asks the endpoint for strict structured output. json_object puts the schema in the prompt, asks
# for a JSON object and checks the result with the same schema. Use it for a local server that lacks json_schema.
OPENAI_STRUCTURED_OUTPUT=json_schema

# Local model (Ollama or vLLM)
# Uncomment the five lines below to run against a model on this machine. A later line wins over an earlier one.
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:3b-instruct
# OPENAI_STRUCTURED_OUTPUT=json_object

# YoVouch voice notes (optional). An Azure transcription deployment (uses the endpoint and key above, no chat
# deployment needed), else TRANSCRIBE_MODEL on the OpenAI-compatible endpoint. Empty: typed answers only.
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=
TRANSCRIBE_MODEL=

YOMA_API_BASE=https://api.yoma.world/api/v3
# Set to 0 to skip the two live Yoma API tests in tests/live.test.cjs when offline
# (Set it in the shell, not here: tests read process.env only.)
# YOCV_LIVE_YOMA=0
PORT=4173
HOST=127.0.0.1

# YoCard: read a real Yoma account instead of the sample personas (stage or production bearer token).
# A token only works against the API it was issued for: a token copied from stage.yoma.world needs
# YOMA_API_BASE set to the stage API base (the https://.../api/v3 origin that stage.yoma.world's requests
# go to in the same network tab). The default YOMA_API_BASE above is production.
YOMA_ACCESS_TOKEN=
# Public base URL used in card links, QR and share text (default http://HOST:PORT)
YOCARD_PUBLIC_URL=

# YoVouch. 1 mounts the simulated SMS and WhatsApp gateways and the /demo pages (demo only).
YOVOUCH_SIM=
# Shared secret a real SMS or WhatsApp gateway sends in x-yovouch-gateway-secret. Empty: no webhooks.
YOVOUCH_GATEWAY_SECRET=
# Shortcode and toll-free call-back number printed on the worker's code page.
YOVOUCH_SHORTCODE=12345
YOVOUCH_CALLBACK_NUMBER=0800 000 000
# Market of the shortcode, used to read a local-format sender number with no card context.
YOVOUCH_SMS_COUNTRY=South Africa
# Demo organisation keys for the referral page, one per YOVOUCH_ORG_KEY_<NAME> (SAMPLE_SKILLS_TRUST is the
# organisation "Sample Skills Trust"). A demo key is labelled as one on every page; a real key needs Yoma.
YOVOUCH_ORG_KEY_SAMPLE_SKILLS_TRUST=demo-sample-skills-trust

# YoCV. Shared secret a service sends in x-yocv-service-secret to POST /api/cv/draft. Empty: no draft webhook.
YOCV_SERVICE_SECRET=
